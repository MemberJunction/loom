{
  "name": "@memberjunction/loom-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Command-line interface for Loom simulation engine: build, accumulate, validate, and emit",
  "license": "BUSL-1.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "loom": "dist/bin/loom.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin/loom.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@memberjunction/loom-contracts": "workspace:*",
    "@memberjunction/loom-engine": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
